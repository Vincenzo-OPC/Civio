      "value": {
        "kind": "assisted_check",
        "prompt": "For the bag priced at ₱900 after a 25% markup, which relationship matches the wording?",
        "options": [
          {
            "id": "125",
            "text": "Original × 1.25 = ₱900",
            "feedback": "Yes. That relation gives original = 900 ÷ 1.25 = ₱720. This is a correction after help; continue guided practice or pause.",
            "next": "remedial_exit",
            "evidence": "assisted_check",
            "hypothesis": null
          },
          {
            "id": "75",
            "text": "Original × 0.75 = ₱900",
            "feedback": "A 25% markup increases the original to 125%, not 75%. The matching relation is original × 1.25 = 900.",
            "next": "remedial_exit",
            "evidence": "assisted_check",
            "hypothesis": null
          },
          {
            "id": "unknown",
            "text": "I am not sure",
            "feedback": "Treat the unknown original as 100%. After adding 25%, the given price is 125%. A slower worked explanation is available.",
            "next": "remedial_exit",
            "evidence": "unknown",
            "hypothesis": null
          }
        ]
      }
    },
