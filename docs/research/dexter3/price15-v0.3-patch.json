      "op": "add",
      "path": "/flows/successive-price/nodes/percent_help",
      "value": {
        "kind": "hint",
        "level": 1,
        "text": "Percent describes a fraction of a base amount. For 10%, divide the base into ten equal parts; it is not always ₱10. For 1%, divide into one hundred parts.",
        "next": "percent_check",
        "requires": "learner_requests_next_hint"
      }
    },
    {
      "op": "add",
      "path": "/flows/successive-price/nodes/percent_check",
      "value": {
        "kind": "assisted_check",
        "prompt": "After that reminder, what is 10% of ₱300?",
        "options": [
          {
            "id": "30",
            "text": "₱30",
            "feedback": "Yes: one tenth of ₱300 is ₱30. This checks this calculation after help; it does not establish broad percentage mastery.",
            "next": "retry",
            "evidence": "assisted_check",
            "hypothesis": null
          },
          {
            "id": "3",
            "text": "₱3",
            "feedback": "₱3 is one hundredth, or 1%, of ₱300. We should continue with the hundredths/tenths relationship before returning to a longer price problem.",
            "next": "arithmetic_exit",
            "evidence": "assisted_check",
            "hypothesis": null
          },
          {
            "id": "10",
            "text": "₱10",
            "feedback": "₱10 is 10% of ₱100; with a base of ₱300, 10% is ₱30. We have not established why you chose ₱10. A smaller guided step may help.",
            "next": "arithmetic_exit",
            "evidence": "assisted_check",
            "hypothesis": null
          },
          {
            "id": "unknown",
            "text": "I am not sure",
            "feedback": "We can pause here and use a smaller foundation step. No misconception is established by uncertainty.",
            "next": "arithmetic_exit",
            "evidence": "unknown",
            "hypothesis": null
          }
        ]
      }
    },
