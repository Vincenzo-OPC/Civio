#!/bin/sh
# Entire CLI hooks
# Civio: committed git hook. Enable once per clone with
#   git config core.hooksPath .githooks
# Uses `entire` from PATH, else the Windows Scoop install. Exits 0 quietly when
# Entire is not installed, so the box, CI and other machines are unaffected.
entire_bin=$(command -v entire 2>/dev/null)
if [ -z "$entire_bin" ]; then
    for candidate in "${SCOOP:-$HOME/scoop}/apps/entire/current/entire.exe" "${SCOOP:-$HOME/scoop}/shims/entire.exe"; do
        if [ -f "$candidate" ]; then
            entire_bin=$candidate
            break
        fi
    done
fi
# Lets Entire check the Entire-Checkpoint trailer in the commit message.
[ -n "$entire_bin" ] || exit 0
"$entire_bin" hooks git commit-msg "$1" || true
