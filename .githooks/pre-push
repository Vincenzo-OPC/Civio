#!/bin/sh
# Entire CLI hooks
# Civio: committed git hook. Enable once per clone with
#   git config core.hooksPath .githooks
# Uses `entire` from PATH, else the Windows Scoop install. Exits 0 quietly when
# Entire is not installed, so the box, CI and other machines are unaffected.
entire_bin=$(command -v entire 2>/dev/null)
if [ -z "$entire_bin" ]; then
    for candidate in "${SCOOP:-$HOME/scoop}/apps/entire/current/entire.exe" "${SCOOP:-$HOME/scoop}/shims/entire.exe"; do
        if [ -f "$candidate" ]; then
            entire_bin=$candidate
            break
        fi
    done
fi
# Pushes Entire checkpoints (refs/entire/checkpoints/...) alongside your push,
# then runs .githooks/pre-push.pre-entire if it exists. $1 is the remote name.
# Like Entire's own hook, a failing `entire hooks git pre-push` stops the push
# (it fails on purpose on privacy-critical problems; transient checkpoint
# upload failures are only logged).
_entire_input=$(cat)
_entire_replay() {
    if [ -n "$_entire_input" ]; then
        printf '%s\n' "$_entire_input"
    fi
}
if [ -n "$entire_bin" ]; then
    _entire_replay | "$entire_bin" hooks git pre-push "$1" || exit $?
fi
_entire_hook_dir="$(dirname "$0")"
if [ -x "$_entire_hook_dir/pre-push.pre-entire" ]; then
    _entire_replay | "$_entire_hook_dir/pre-push.pre-entire" "$@" || exit $?
fi
exit 0
