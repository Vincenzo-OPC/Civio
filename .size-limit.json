[
    {
        "name": "Main entry JS, loaded on every page (brotli)",
        "path": "public/build/assets/app-*.js",
        "limit": "50 kB"
    },
    {
        "name": "Vendor JS: React, Inertia, Radix (brotli)",
        "path": "public/build/assets/vendor-*.js",
        "limit": "125 kB"
    },
    {
        "name": "App CSS (brotli)",
        "path": "public/build/assets/app-*.css",
        "limit": "33 kB"
    },
    {
        "name": "Exam page chunk (brotli)",
        "path": "public/build/assets/exams-*.js",
        "limit": "12 kB"
    },
    {
        "name": "All JS chunks, lazy ones included (brotli)",
        "path": "public/build/assets/*.js",
        "limit": "1060 kB"
    }
]
