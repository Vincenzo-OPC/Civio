APP_NAME="Civio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=cse_reviewer
DB_USERNAME=civio
DB_PASSWORD=civio_local_dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AI â€” leave empty until GT provides a real key (AI features only)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional â€” leave blank for local
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost:8080/auth/google/callback

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local study: unlimited guest mocks (no register wall)
CIVIO_GUEST_UNLIMITED=true
CIVIO_CONTENT_SHIELD=false

# --- Civio Phase 0 extras ---
# Tutor / AI (server-side only — never VITE_*)
CIVIO_TUTOR_PROVIDER=null
# Optional Prism-backed keys (unused while provider=null)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Sentry (disabled unless DSN set)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Browser migrate/rollback (never enable in production)
CIVIO_ALLOW_BROWSER_MIGRATIONS=false
