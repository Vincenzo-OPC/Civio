# Dependencies are installed inside the image.
.git
node_modules
vendor
modules

# Secrets. The committed examples stay.
.env
.env.*
!.env.example
auth.json
*.pem
*.key
*.p12
*.pfx

# Local databases and dumps. Source SQL scripts stay.
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sql.gz
*.dump
*.dump.gz
*.backup
*.bak

# Logs
*.log
npm-debug.log*
yarn-error.log*
yarn-debug.log*

# Generated caches. Directory markers stay so the image keeps the paths.
bootstrap/cache/*
!bootstrap/cache/.gitignore
storage/logs/*
!storage/logs/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
storage/pail

# Uploads and local exports. Directory markers stay.
storage/app/*
!storage/app/private/
!storage/app/public/
!storage/app/.gitignore
storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
public/storage
public/hot
public/build

# Host tooling
.idea
.vscode
.fleet
.nova
.zed
.phpactor.json
.phpunit.cache
.phpunit.result.cache
Homestead.json
Homestead.yaml
